# TuitionBridge — copy to .env (never commit .env). Every value here is a DEMO value.
DATABASE_PATH=./tuitionbridge.db
# key:role:account_id   roles: viewer=Tier0 analyst=Tier1 planner=Tier2 student=Tier3
API_KEYS=demo-viewer-key:viewer:acct_demo_student,demo-analyst-key:analyst:acct_demo_student,demo-planner-key:planner:acct_demo_student,demo-student-key:student:acct_demo_student,demo-other-key:student:acct_other
PER_TRANSFER_CAP_USD=15000
DAILY_CAP_USD=20000
QUOTE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=120
# Optional LLM explanations via the Anthropic Messages API. Blank = deterministic fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=12
